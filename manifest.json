{
  "manifest_version": 3,
  "name": "ImageToPrompt",
  "version": "1.1",
  "description": "反推图片提示词 (Image to Prompt) - 支持抖音等现代网站",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "ImageToPrompt - 右键图片或按 Alt+Q 触发"
  },
  "commands": {
    "trigger-i2p": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "触发 ImageToPrompt 智能探测"
    }
  }
}
